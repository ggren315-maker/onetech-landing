# Telegram Bot для заявок з форми
# 1. Створіть бота: @BotFather -> /newbot -> скопіюйте токен
# 2. Напишіть боту будь-яке повідомлення
# 3. Відкрийте: https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
# 4. Знайдіть "chat":{"id": XXXXX} — це ваш CHAT_ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
PORT=5500

# Auto price sync from aquafamily.ua (runs in background while server is up)
PRICE_UPDATE_ENABLED=1
PRICE_UPDATE_HOURS=6
PRICE_UPDATE_ON_START=1

# Secret for /api/catalog-sync (cron jobs). Render generates this automatically.
SYNC_SECRET=change-me-to-random-string
